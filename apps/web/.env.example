# Copy to .env and fill in real values, then restart the dev server.
# VITE_CONVEX_URL comes from `npx convex dev` (it prints CONVEX_URL).
VITE_CONVEX_URL=https://YOUR-DEPLOYMENT.convex.cloud
# Zitadel OIDC issuer + public SPA client id (see docs/zitadel-runbook.md).
VITE_ZITADEL_ISSUER=https://auth.example.com
VITE_ZITADEL_CLIENT_ID=your-zitadel-client-id
# Optional: overrides window.location.origin for redirect URIs.
# VITE_APP_URL=https://your-web-origin
